# Image / service
IMAGE=ghcr.io/khaisilk1910/camera-tts-ezviz:latest
HOSTNAME=camera-tts-ezviz
TZ=Asia/Ho_Chi_Minh
PORT=8124
API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_KEY
ALLOW_NO_AUTH=false
CACHE_VOLUME_NAME=camera-tts-ezviz-cache

# Global TTS
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_EDGE_VOLUME=+0%
TTS_GAIN_DB=4
TTS_SAMPLE_RATE=16000
TTS_BITRATE=32k

# Queue / performance
QUEUE_SIZE=30
MAX_TEXT=700
PREP_WORKERS=4
HTTP_THREADS=8
SEND_TIMEOUT=180
PREP_TIMEOUT=300
TTS_TIMEOUT=120
CACHE_MAX_MB=512
CACHE_TTL_DAYS=30
ALLOW_REQUEST_OVERRIDES=true

# Camera defaults
CAMERA_DEFAULT_PORT=8000
CAMERA_DEFAULT_VOICE_CHAN=1
CAMERA_CONNECT_TIMEOUT_MS=3000
CAMERA_RECONNECT_INTERVAL_MS=10000
DEFAULT_CAMERA=gate

# Camera 01
CAMERA_01_ENABLED=true
CAMERA_01_ID=gate
CAMERA_01_IP=192.168.31.59
CAMERA_01_PORT=8000
CAMERA_01_USER=admin
CAMERA_01_PASSWORD=CHANGE_ME
CAMERA_01_VOICE_CHAN=1
CAMERA_01_GAIN_DB=4
CAMERA_01_QUEUE_SIZE=30

# Camera 02
CAMERA_02_ENABLED=false
CAMERA_02_ID=yard
CAMERA_02_IP=192.168.31.60
CAMERA_02_PORT=8000
CAMERA_02_USER=admin
CAMERA_02_PASSWORD=CHANGE_ME
CAMERA_02_VOICE_CHAN=1
CAMERA_02_GAIN_DB=4
CAMERA_02_QUEUE_SIZE=30

# Optional: instead of CAMERA_01_* slots, use one JSON array/object.
# CAMERAS_JSON=[{"id":"gate","ip":"192.168.31.59","user":"admin","password":"CHANGE_ME","gain_db":4}]
