# ============================================================
# Camera TTS EZVIZ - Portainer variables (compact)
# Only these variables need to appear in Portainer.
# ============================================================

PORT=8124
API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_KEY

# Leave empty if Home Assistant always sends camera=...
# If set, the value must match a camera name in CAMERAS_JSON.
DEFAULT_CAMERA=gate

# Global output gain in dB. Recommended starting range: 4 to 6.
# Allowed by the application: -20 to +12.
TTS_GAIN_DB=4

TTS_VOICE=vi-VN-HoaiMyNeural

# ------------------------------------------------------------
# Cameras: ONE variable manages all cameras.
# Common defaults automatically inherited by every camera:
#   port=8000, voice_chan=1, queue_size=30, gain_db=TTS_GAIN_DB
#
# One camera example:
# CAMERAS_JSON={"gate":{"ip":"192.168.31.59","user":"admin","password":"CHANGE_ME"}}
#
# Two camera example:
# CAMERAS_JSON={"gate":{"ip":"192.168.31.59","user":"admin","password":"PASS_GATE"},"yard":{"ip":"192.168.31.60","user":"admin","password":"PASS_YARD"}}
#
# Per-camera override example (yard louder at 6 dB):
# CAMERAS_JSON={"gate":{"ip":"192.168.31.59","user":"admin","password":"PASS_GATE"},"yard":{"ip":"192.168.31.60","user":"admin","password":"PASS_YARD","gain_db":6}}
# ------------------------------------------------------------
CAMERAS_JSON={"gate":{"ip":"192.168.31.59","user":"admin","password":"CHANGE_ME"}}
